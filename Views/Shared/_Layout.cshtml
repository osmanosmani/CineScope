<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - CineScope</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
    <link rel="stylesheet" href="~/CineScope.styles.css" asp-append-version="true" />
</head>
<body>
    <header>
        <nav class="navbar navbar-expand-lg navbar-dark app-navbar border-bottom mb-4">
            <div class="container-fluid px-3 px-lg-4">
                <a class="navbar-brand fw-semibold" asp-area="" asp-controller="Movies" asp-action="Discover">CineScope</a>
                <button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target=".navbar-collapse" aria-controls="navbarSupportedContent"
                        aria-expanded="false" aria-label="Toggle navigation">
                    <span class="navbar-toggler-icon"></span>
                </button>
                <div class="navbar-collapse collapse">
                    <ul class="navbar-nav me-auto mb-3 mb-lg-0">
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Movies" asp-action="Discover">Home</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Movies" asp-action="Index">Movies</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Movies" asp-action="Discover" asp-fragment="genres">Genres</a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link" asp-area="" asp-controller="Movies" asp-action="AboutMe">About Me</a>
                        </li>
                        @if (User.IsInRole("Admin"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Admin" asp-action="Index">Dashboard</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Movies" asp-action="Index">Manage Movies</a>
                            </li>
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="ExternalMovies" asp-action="Search">Import Movies</a>
                            </li>
                        }
                        @if (User.IsInRole("Member"))
                        {
                            <li class="nav-item">
                                <a class="nav-link" asp-area="" asp-controller="Favorites" asp-action="Index">Favorites</a>
                            </li>
                        }
                    </ul>

                    <form asp-controller="Movies" asp-action="Discover" method="get" class="d-flex gap-2 app-search-form me-lg-3 mb-3 mb-lg-0">
                        <label for="navSearchTerm" class="visually-hidden">Search movies</label>
                        <input id="navSearchTerm"
                               name="searchTerm"
                               class="form-control form-control-sm"
                               type="search"
                               placeholder="Search movies"
                               aria-label="Search movies" />
                        <button class="btn btn-sm btn-outline-light" type="submit">Search</button>
                    </form>

                    <div class="d-flex flex-column flex-lg-row gap-2">
                        <span id="activeUsersIndicator" class="active-users-indicator" title="Connected users">
                            Live: <strong id="activeUsersCount">0</strong>
                        </span>
                        @if (User.IsInRole("Admin"))
                        {
                            <a class="btn btn-sm btn-primary" asp-area="" asp-controller="Movies" asp-action="Create">Add Movie</a>
                        }
                        @if (User.Identity?.IsAuthenticated == true)
                        {
                            <span class="navbar-text small text-truncate">@User.Identity.Name</span>
                            <form asp-controller="Account" asp-action="Logout" method="post" class="d-inline">
                                <button type="submit" class="btn btn-sm btn-outline-light">Logout</button>
                            </form>
                        }
                        else
                        {
                            <a class="btn btn-sm btn-outline-light" asp-controller="Account" asp-action="Login">Login</a>
                            <a class="btn btn-sm btn-primary" asp-controller="Account" asp-action="Register">Register</a>
                        }
                    </div>
                </div>
            </div>
        </nav>
    </header>
    <div class="container @(ViewData["ContainerClass"])">
        <main role="main" class="pb-3 @(ViewData["MainClass"])">
            @RenderBody()
        </main>
    </div>

    <footer class="border-top footer text-muted">
        <div class="container">
            &copy; 2026 - CineScope
        </div>
    </footer>
    <div id="reviewToastContainer" class="toast-container position-fixed bottom-0 end-0 p-3"></div>
    <script src="~/lib/jquery/dist/jquery.min.js"></script>
    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script src="~/lib/signalr/signalr.min.js"></script>
    <script src="~/js/site.js" asp-append-version="true"></script>
    <script src="~/js/reviewNotifications.js" asp-append-version="true"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
