@if (TempData["ExternalMovieSuccess"] != null)
{
    <div class="alert alert-success" role="alert">@TempData["ExternalMovieSuccess"]</div>
}

@if (TempData["ExternalMovieWarning"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["ExternalMovieWarning"]</div>
}

@if (TempData["ExternalMovieError"] != null)
{
    <div class="alert alert-warning" role="alert">@TempData["ExternalMovieError"]</div>
}
